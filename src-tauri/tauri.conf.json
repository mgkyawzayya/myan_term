{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyanTerm",
  "version": "0.1.0",
  "identifier": "app.myanterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyanTerm",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "app", "dmg", "msi", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Cross-platform GPU terminal with first-class Myanmar text",
    "longDescription": "MyanTerm is a fast, GPU-accelerated terminal emulator that renders Myanmar (Burmese) Unicode correctly while remaining fully compatible with modern TUI tooling (vim, tmux, lazygit, Claude Code).",
    "copyright": "MIT OR Apache-2.0",
    "publisher": "MyanTerm",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": ["fonts/*"],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mgkyawzayya/myan_term/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
